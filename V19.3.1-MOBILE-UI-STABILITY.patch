+.safety-log-title > span:first-child { font-size: 1.15em; flex: 0 0 auto; }
+.safety-log-actions {
+    display: grid;
+    grid-template-columns: repeat(4, 2.45rem);
+    gap: .34rem;
+    align-items: center;
+}
+.safety-icon-action {
+    width: 2.45rem;
+    min-width: 2.45rem;
+    height: 2.45rem;
+    min-height: 2.45rem;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    padding: 0 !important;
+    border: 1px solid var(--border-color);
+    border-radius: .72rem;
+    background: var(--input-bg);
+    color: var(--text-main);
+    font-size: 1rem !important;
+    font-weight: 950;
+    line-height: 1;
+    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 4px 12px rgba(0,0,0,.16);
+    transition: transform .08s ease, filter .12s ease, border-color .12s ease;
+}
+.safety-icon-action:active { transform: scale(.94); filter: brightness(1.12); }
+.safety-icon-action:disabled { opacity: .58; cursor: wait; }
+.safety-icon-primary { color: #bfdbfe; border-color: rgba(59,130,246,.5); background: rgba(37,99,235,.34); }
+.safety-icon-danger { color: #fecaca; border-color: rgba(239,68,68,.48); background: rgba(127,29,29,.34); }
+.safety-icon-neutral { color: var(--text-muted); }
+.safety-icon-status { border-radius: 999px; font-size: .66rem !important; }
+.safety-icon-status[data-state="ready"] { color: #34d399; border-color: rgba(16,185,129,.46); background: rgba(6,95,70,.26); }
+.safety-icon-status[data-state="syncing"] { color: #60a5fa; border-color: rgba(59,130,246,.48); background: rgba(30,64,175,.25); font-size: .95rem !important; }
+.safety-icon-status[data-state="error"] { color: #fbbf24; border-color: rgba(245,158,11,.5); background: rgba(120,53,15,.28); font-size: .82rem !important; }
