+/* ── v19.3.4 compact mobile monitoring and stable scrolling ───────── */
+/* Director section chips and their scroll observer were removed from markup and JavaScript. */
+
+.director-action-icon svg {
+    width: 1.12rem;
+    height: 1.12rem;
+    display: block;
+    fill: none;
+    stroke: currentColor;
+    stroke-width: 2;
