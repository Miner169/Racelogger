+    .safety-log-actions { grid-template-columns: repeat(4, 2.25rem); gap: .28rem; }
+    .safety-icon-action { width: 2.25rem; min-width: 2.25rem; height: 2.25rem; min-height: 2.25rem; border-radius: .65rem; }
+    .safety-log-title { font-size: .98rem; }
+    #setupHeaderRow > h2 { gap: .32rem; }
+    #setupReadinessBadge { flex: 0 0 auto; }
+    #setupHeaderRow #setupSummary { font-size: .58rem !important; }
+    #lockBtn { max-width: 5.6rem; }
+}
+
+/* ── v19.3.3 entry and command-view refinements ───────────────────── */
+/* Quick Entry keeps only the large numeric pad visible. ABC hands control to
+   the native keyboard without replacing the race-day number pad with tiny keys. */
+.minimal-keyboard-tabs-two { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
