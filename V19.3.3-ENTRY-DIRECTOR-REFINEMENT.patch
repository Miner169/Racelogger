+    installDirectorNavigation();
+    installWidgetHelpToggles();
+    installMapFullscreen();
+    installMinimalModeEnhancements();
+    installSafetyToolbar();
+    installSafetyScrollHint();
+    installDirectorKeyboardShortcuts();
