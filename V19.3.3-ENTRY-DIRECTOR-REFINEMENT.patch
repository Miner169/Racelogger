+.safety-icon-status { border-radius: 999px; font-size: .66rem !important; }
+.safety-icon-status[data-state="ready"] { color: #34d399; border-color: rgba(16,185,129,.46); background: rgba(6,95,70,.26); }
+.safety-icon-status[data-state="syncing"] { color: #60a5fa; border-color: rgba(59,130,246,.48); background: rgba(30,64,175,.25); font-size: .95rem !important; }
